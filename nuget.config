<?xml version="1.0" encoding="utf-8"?>
<!--
  EffectGraph's packages come only from nuget.org. Other packages may also come
  from a source in your own NuGet.Config, once that config maps it, e.g.
  <packageSource key="mirror"><package pattern="*" /></packageSource>:
  with source mapping on, NuGet uses an unmapped source for nothing.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="EffectGraph" />
      <package pattern="EffectGraph.*" />
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
