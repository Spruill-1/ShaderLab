<Project Sdk="Microsoft.NET.Sdk">
  <!-- The packages' test: references the packed EffectGraph package from the
       local feed, as a user's project would. packaging/Pack.ps1 runs it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <EffectGraphVersion Condition="'$(EffectGraphVersion)' == ''">0.0.0-dev</EffectGraphVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="EffectGraph" Version="$(EffectGraphVersion)" />
  </ItemGroup>
</Project>
