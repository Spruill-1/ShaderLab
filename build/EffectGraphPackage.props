<?xml version="1.0" encoding="utf-8"?>
<!--
  The EffectGraph ShaderLab builds against. packages.config pins the same
  version for EffectGraph.Engine and EffectGraph.Native; change both together.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <EffectGraphPackageVersion>1.0.2</EffectGraphPackageVersion>
    <EffectGraphPackagesDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\packages\'))</EffectGraphPackagesDir>
  </PropertyGroup>
</Project>
