<?xml version="1.0" encoding="utf-8"?>
<!--
  Where ShaderLab's projects get EffectGraph's engine. Import after
  Microsoft.Cpp.targets.

  Source (the default): the engine project in EffectGraphSourceDir, this
  repository unless set (a sibling EffectGraph checkout after the repo split),
  with the built-in effect headers generated by its EffectGraphBuiltIns.targets.

  Package: set EffectGraphEnginePackageDir to an EffectGraph.Engine package's
  folder; its targets add the headers, built-in headers and library.

  A project that needs only the headers (a static library, the MCP broker) sets
  EffectGraphEngineHeadersOnly to true before importing this.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <EffectGraphEngineFromPackage Condition="'$(EffectGraphEnginePackageDir)' != ''">true</EffectGraphEngineFromPackage>
    <EffectGraphSourceDir Condition="'$(EffectGraphSourceDir)' == ''">$(MSBuildThisFileDirectory)..\</EffectGraphSourceDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(EffectGraphEngineFromPackage)' != 'true' and '$(EffectGraphEngineHeadersOnly)' != 'true'">
    <ProjectReference Include="$(EffectGraphSourceDir)ShaderLabEngine.vcxproj">
      <Project>{A7A1E0F1-665C-4D06-9AC7-6D6B6A0D0F01}</Project>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <LinkLibraryDependencies>true</LinkLibraryDependencies>
    </ProjectReference>
  </ItemGroup>
  <ItemDefinitionGroup Condition="'$(EffectGraphEngineFromPackage)' != 'true'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(EffectGraphSourceDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <Import Project="$(EffectGraphSourceDir)build\EffectGraphBuiltIns.targets"
          Condition="'$(EffectGraphEngineFromPackage)' != 'true' and '$(EffectGraphEngineHeadersOnly)' != 'true'" />

  <Import Project="$(EffectGraphEnginePackageDir)build\native\EffectGraph.Engine.targets"
          Condition="'$(EffectGraphEngineFromPackage)' == 'true'" />
</Project>
