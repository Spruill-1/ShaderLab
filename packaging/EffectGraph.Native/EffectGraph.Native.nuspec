<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>EffectGraph.Native</id>
    <version>$version$</version>
    <authors>David Spruill</authors>
    <license type="expression">MIT-0</license>
    <description>EffectGraph: ShaderLab's HDR effect library and graph evaluator for D3D11 and Direct2D programs. Native package: EffectGraph.dll (x64, ARM64), its import libraries, EffectGraph.h, a header and an .effectblob file per built-in effect, and EffectGraphCompile for building your own effects. C++ projects get the include path, library and DLL copy from build/native; .NET projects get the DLL from runtimes/.</description>
    <projectUrl>https://github.com/Spruill-1/ShaderLab</projectUrl>
    <tags>direct2d d3d11 hdr shaders effects native</tags>
    <readme>README.md</readme>
  </metadata>
  <files>
    <file src="README.md" target="" />
    <file src="build\native\**" target="build\native" />
    <file src="runtimes\**" target="runtimes" />
    <file src="tools\**" target="tools" />
    <file src="effects\**" target="effects" />
  </files>
</package>
